APP_ENV=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com
DEEPSEEK_BASE_URL=https://api.deepseek.com

OPENAI_MODELS=gpt-5-mini
ANTHROPIC_MODELS=claude-sonnet-4-5
DEEPSEEK_MODELS=deepseek-flash,deepseek-v4-pro

DEFAULT_PROVIDER=mock
CONVERSATION_DB_PATH=../data/llm_toolbox.db
REQUEST_TOTAL_TIMEOUT_SECONDS=60
STREAM_IDLE_TIMEOUT_SECONDS=30
MAX_CONCURRENT_REQUESTS=20
MAX_RETRIES=2
MAX_MESSAGES=50
MAX_MESSAGE_CHARS=50000
MAX_TOTAL_MESSAGE_CHARS=100000
MAX_OUTPUT_TOKENS_LIMIT=8192
WEB_SEARCH_TIMEOUT_SECONDS=8
WEB_SEARCH_MAX_RESULTS=5

# 浏览器访问后端的地址。Docker 与本地运行默认值相同。
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
